
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define SHIFT 1
#define EXT 2
#define SYM1 3
#define SYM2 4
#define FNC 5
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	behaviors {
		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "QUICK_TAP";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};

		// Homerow Mods
		// Tap the key for the letter, hold for the modifier.
		// Tapping term is set to 200ms.
		hm: homerow_mods {
			compatible = "zmk,behavior-hold-tap";
			label = "HOMEROW_MODS";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			flavor = "tap-preferred";
			bindings = <&kp>, <&kp>;
		};
	};

	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
	};

	combos {
		compatible = "zmk,combos";
		// internal-left & external-right thumb keys
		combo_sym2 {
			timeout-ms = <200>;
			key-positions = <31 33>;
			bindings = <&mo SYM2>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer
		// QWERTY Layout with Homerow Mods
		// GACS Order: GUI - Alt - Ctrl - Shift (Shift on Index finger)
		default_layer {
			label = "Base";
			bindings = <
			&kp Q      	&kp W      	&kp E       &kp R       &kp T           &kp Y 		&kp U        &kp I        &kp O       &kp P 
			&hm LGUI A 	&hm LALT S 	&hm LCTRL D &hm LSHIFT F &kp G 		    &kp H 		&hm RSHIFT J &hm RCTRL K  &hm RALT L  &hm RGUI SQT
			&kp Z      	&kp X      	&kp C       &kp V       &kp B           &kp N 		&kp M        &kp COMMA    &kp DOT     &kp FSLH
						            &sl EXT 	&kp SPACE                   &sl SHIFT 	&sl SYM1
			>;
		};

		// Base layer shifted
		// Updated to match QWERTY shifted keys
		shift_layer {
			label = "Shift";
			bindings = <
			&kp LS(Q) &kp LS(W) &kp LS(E) &kp LS(R) &kp LS(T)		&kp LS(Y) &kp LS(U)  &kp LS(I)     &kp LS(O)      &kp LS(P) 
			&kp LS(A) &kp LS(S) &kp LS(D) &kp LS(F) &kp LS(G)  		&kp LS(H) &kp LS(J)  &kp LS(K)     &kp LS(L)      &kp DQT
			&kp LS(Z) &kp LS(X) &kp LS(C) &kp LS(V) &kp LS(B)       &kp LS(N) &kp LS(M)  &kp LESS_THAN &kp GREATER_THAN &kp QMARK
											&mo EXT &kp SPACE       &sl SHIFT  &sl SYM1
			>;
		};

		// Main modifiers and arrow keys
		ext_layer {
			label = "EXT";
			bindings = <
			&kp ESC  	&kp LG(X) 	&kp LG(V)  	&sk LA(LSHIFT)  &kp LC(LA(LS(S)))	&kp PG_UP  	&kp HOME 	&kp UP 		&kp END 		&kp INS
			&sk LCTRL 	&sk LSHIFT 	&sk LGUI  	&sk LALT        &sk LA(LS(LCTRL)) 	&kp PG_DN 	&kp LEFT  	&kp DOWN  	&kp RIGHT   	&kp DEL
			&kp LC(Z)  	&kp LC(X) 	&kp LC(C) 	&kp LC(V)       &kp TAB             &kp LC(BSPC) &kp BSPC 	&kp C_MUTE 	&kp C_VOL_DN  	&kp C_VOL_UP
												&trans          &kp LCTRL    		&kp ENTER  &mo FNC 
			>;
		};

		// Numbers and symbols
		sym1_layer {
			label = "Sym";
			bindings = <
			&kp LESS_THAN &kp GREATER_THAN &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSLASH		&kp PLUS 	&kp N7 &kp N8 &kp N9 &kp EQUAL
			&kp EXCLAMATION &kp AT &kp LPAR &kp RPAR &kp STAR  									&kp MINUS 	&kp N4 &kp N5 &kp N6 &kp SLASH
			&kp CARET &kp AMPERSAND &kp LEFT_BRACE &kp RIGHT_BRACE &kp UNDERSCORE 				&kp N0 		&kp N1 &kp N2 &kp N3 &kp PRCNT
														&mo FNC  &sl SYM2       				&trans &trans
			>;
		};

		// Low frequency symbols.
		sym2_layer {
			label = "Sym.2";
			bindings = <
			&kp HASH &kp UNDERSCORE &none &none &kp DOLLAR      	&kp LS(1) &kp LS(2) &kp LS(3) &kp LS(4) &kp LS(5) 
			&kp GRAVE &kp TILDE &kp PIPE &none &kp GRAVE	        &none &kp LA(A) &none &kp LA(A) &none
			&none &none &none &none &kp HASH			  			&none &none &none &none &none
								&none &none        					&none &none 
			>;
		};


		// Function keys with modifiers
		fnc_layer {
			label = "FNC";
			bindings = <
			&kp F1 	&kp F2 	&kp F3	&kp F4 	&kp F5                              &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 
			&sk LCTRL &sk LSHIFT &sk LGUI &sk LALT &sk RALT  	                &kp F11 &kp F12  &kp PRINTSCREEN &unstick &trans
			&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3      &studio_unlock &none &none &none	&bootloader 
							  &none &none              			                &none &none  
			>;
		};

	};
};
